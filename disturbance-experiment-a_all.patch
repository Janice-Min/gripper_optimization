+    """Bisection on the constant force. Returns (F_hold, censored, trials)."""
+    tol, cap = s["tol_N"], s["cap_N"]
+    trials = []
+
+    def held(force):
+        ok, cause, sec = hold_trial(model, data, state, d_hand, force, s, crit)
